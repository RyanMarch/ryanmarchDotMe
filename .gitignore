.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Exclude large binary media and project archive files from Git (they are uploaded to R2 automatically)
*.mp3
*.m4a
*.aup3
*.zip

# Build/upload cache files
dev/.r2_cache.json

# Node modules
node_modules/

# Local-only AI instruction file
GEMINI.md

# Claude Code project config (local dev-server/session config, not shareable)
.claude/

# Build artifacts
sitemap.xml
coverage/

# Editor workspace and Pixelmator source files (local only)
.vscode/
*.pxd
