{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ryanmarchdotme",
  "main": "worker.js",
  "compatibility_date": "2026-05-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "ryanmarch.me",
      "custom_domain": true
    }
  ]
}
