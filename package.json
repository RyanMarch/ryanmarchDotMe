{
  "name": "ryanmarchdotme",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio site for Ryan March, served from Cloudflare Workers.",
  "author": "Ryan March",
  "license": "UNLICENSED",
  "homepage": "https://ryanmarch.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanMarch/ryanmarchDotMe.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "npm run test && node scripts/build.js",
    "create-project": "node dev/create-project.js",
    "image-variants": "node dev/make-image-variants.mjs",
    "shrink-images": "node dev/shrink-images.mjs",
    "sync-lcp": "node scripts/lcp-preload.js",
    "test": "vitest run",
    "lint": "eslint --config config/eslint.config.js .",
    "lint:fix": "eslint --config config/eslint.config.js . --fix",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.8",
    "wrangler": "^4.167.0"
  }
}
