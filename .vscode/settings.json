{
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "project/": true,
        "**/*.webp": true,
        "**/*.png": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.mp3": true,
        "dev/og-image.pxd": true,
        "dev/.r2_cache.json": true,
        "**/.wrangler": true,
        "**/dev/downloadReports": true
    },
    "files.exclude": {
        "project/": true,
        "wrangler.jsonc": true,
        "sitemap.xml": true,
        "robots.txt": true,
        "worker.js": true,
        "GEMINI.md": true,
        "_headers": true,
        ".assetsignore": true,
        "build.js": true
    },
    "liveServer.settings.ignoreFiles": [
        "**/.git/**",
        ".git/**",
        "**/.vscode/**",
        ".vscode/**",
        "**/.DS_Store",
        "**/.DS_Store?",
        "**/._*",
        "**/.Spotlight-V100/**",
        "**/.Trashes/**",
        "**/node_modules/**",
        "node_modules/**",
        "**/dev/**",
        "dev/**",
        "**/.wrangler/**",
        ".wrangler/**",
        "**/sitemap.xml",
        "**/robots.txt",
        "**/package.json",
        "**/package-lock.json",
        "**/wrangler.jsonc",
        "**/.gitignore",
        "**/README.md",
        "**/.r2_cache.json"
    ],
    "liveServer.settings.wait": 1000,
    "liveServer.settings.port": 5588,
    "liveServer.settings.donotVerifyTags": true,
    "liveServer.settings.proxy": {
        "enable": true,
        "baseUri": "/",
        "proxyUri": "http://127.0.0.1:8000"
    }
}