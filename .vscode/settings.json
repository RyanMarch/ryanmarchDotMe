{
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "project/": true,
        "**/*.webp": true,
        "**/*.avif": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.mp3": true,
        "dev/og-image.pxd": true,
        "dev/.r2_cache.json": true,
        "**/.wrangler": true,
        "**/dev/downloadReports": true
    },
    "files.exclude": {
        "project/": true,
        "wrangler.jsonc": true,
        // "sitemap.xml": true,
        ".wrangler": true,
        "node_modules": true,
        "robots.txt": true,
        "worker.js": true,
        "GEMINI.md": true,
        "_headers": true,
        ".assetsignore": true,
        "build.js": true
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.expand": false,
    "explorer.fileNesting.patterns": {
        "package.json": "package-lock.json, .gitignore, .assetsignore, wrangler.jsonc, README.md, robots.txt, sitemap.xml, GEMINI.md, build.js, worker.js, _headers",
        // "index.html": "404.html, admin.html, redirects.json, style.css"
    },
    "liveServer.settings.ignoreFiles": [
        "**/.git/**",
        ".git/**",
        "**/.vscode/**",
        ".vscode/**",
        "**/.DS_Store",
        "**/.DS_Store?",
        "**/._*",
        "**/.Spotlight-V100/**",
        "**/.Trashes/**",
        "**/node_modules/**",
        "node_modules/**",
        "**/dev/**",
        "dev/**",
        "**/.wrangler/**",
        ".wrangler/**",
        "**/sitemap.xml",
        "**/robots.txt",
        "**/package.json",
        "**/package-lock.json",
        "**/wrangler.jsonc",
        "**/.gitignore",
        "**/README.md",
        "**/.r2_cache.json"
    ],
    "liveServer.settings.wait": 1000,
    "liveServer.settings.port": 5588,
    "liveServer.settings.donotVerifyTags": true,
    "liveServer.settings.proxy": {
        "enable": true,
        "baseUri": "/",
        "proxyUri": "http://127.0.0.1:8000"
    },
    "VsCodeTaskButtons.tasks": [
        {
            "label": "Start Server",
            "task": "Open Browser",
            "tooltip": "Start the local development server with SPA routing"
        }
    ]
}