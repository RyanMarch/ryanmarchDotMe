# ============================================================
# Cloudflare Pages — Response Headers
# ============================================================

# ── Fonts: immutable, long-lived cache + CORS for cross-origin @font-face
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ── Images: long-lived cache (bump filenames to bust)
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# ── JS / CSS: immutable, long-lived cache. build.js appends a content-hash
# ── ?v= query string to every reference on each build, so a deploy that
# ── changes a file's content automatically busts old caches via a new URL.
/style.css
  Cache-Control: public, max-age=31536000, immutable
/assets/js/projects.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/theme.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/project-data.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/audio-player.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/lightbox.js
  Cache-Control: public, max-age=31536000, immutable
/assets/js/brochure.js
  Cache-Control: public, max-age=31536000, immutable

# ── Fallback for any other JS under this path (e.g. beacon.min.js, a vendor
# ── script build.js does not hash) — shorter cache since its filename never changes.
/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# ── Favicons: reasonably long cache
/assets/favicon/*
  Cache-Control: public, max-age=604800

# ── Content images: long-lived cache (static binary assets, bump filename to bust)
/content/:project/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── Content HTML fragments (loaded dynamically by the SPA router)
/content/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# ── Root HTML + sitemap: short cache so changes propagate quickly
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=3600

# ── Admin Page (noindex search engines)
/admin
  X-Robots-Tag: noindex, nofollow
/admin.html
  X-Robots-Tag: noindex, nofollow

# ── Security headers (applied globally)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https://media.ryanmarch.me; media-src 'self' https://media.ryanmarch.me; connect-src 'self' https://cloudflareinsights.com https://cdn.jsdelivr.net; frame-src 'self' https://www.youtube-nocookie.com;
