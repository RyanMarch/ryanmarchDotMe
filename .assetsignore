# Exclude large audio files from Wrangler static asset upload
*.mp3

# Exclude Git, tool configurations, and local logs/caches
.git/
.wrangler/
.vscode/
.DS_Store
node_modules/

# Exclude development scripts and templates from deployed assets
dev/
scripts/
tests/
config/

# Exclude repo/tooling metadata that has no reason to be publicly fetchable
package.json
package-lock.json
wrangler.jsonc
redirects.json
.github/
